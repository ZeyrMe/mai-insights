{
  "manifest_version": 2,
  "id": "zeyr.mai-insights",
  "version": "0.1.0",
  "name": "麦麦见闻",
  "description": "后台采集、整理见闻与定向分享",
  "author": {
    "name": "zeyr",
    "url": "https://github.com/zeyr"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/zeyr/mai-insights"
  },
  "host_application": {
    "min_version": "1.4.8",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "feedparser",
      "version_spec": "<7,>=6"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": "<1,>=0.28"
    }
  ],
  "capabilities": [
    "api.get",
    "api.call",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "send.text",
    "llm.generate",
    "maisaka.reply.generate",
    "message.get_by_time_in_chat"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "changelog": "CHANGELOG.md",
  "plugin_type": "chat"
}
